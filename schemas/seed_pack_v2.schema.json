{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:animus:seed-pack:v2",
  "title": "Animus seed pack v2",
  "description": "Shape contract. pipeline.seed_pack additionally validates finite JSON, unique identities, reference closure, source permissions, date validity, blueprint executability, statement conditions, and contract digests. review.blocking_issues gates generation, not archive validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "seed_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "task": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "forbidden_inferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      },
      "required": [
        "objective",
        "instructions"
      ],
      "additionalProperties": false
    },
    "exemplars": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exemplar"
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism"
      },
      "minItems": 1
    },
    "blueprint_requirements": {
      "type": "object",
      "properties": {
        "entity_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "minItems": 1
        },
        "relation_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "event_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "causal_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/causal"
          }
        },
        "evidence_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "temporal_model": {
          "$ref": "#/$defs/temporal"
        },
        "state_machines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_machine"
          }
        },
        "metric_definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      },
      "required": [
        "entity_types",
        "relation_types",
        "event_types",
        "causal_rules",
        "evidence_channels",
        "temporal_model"
      ],
      "additionalProperties": false
    },
    "document_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                }
              },
              "required": [
                "locator"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "source_id",
          "segments"
        ],
        "additionalProperties": false
      }
    },
    "generation_contract": {
      "type": "object",
      "properties": {
        "syntheticization": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "must_include": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "must_distinguish": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "must_not_infer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "sensitive_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "active_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "traps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "conditional_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "synthetic_designs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "blocking_issues": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "seed_id",
    "family",
    "title",
    "description",
    "sources",
    "task",
    "exemplars",
    "mechanisms",
    "blueprint_requirements",
    "generation_contract"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "digest": [
      "contract_digest"
    ],
    "contract_digest": [
      "digest"
    ]
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "required": [
        "source_id",
        "locator"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "role": {
          "enum": [
            "corpus",
            "builder_only",
            "evaluator_only"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "date_scope": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "allowed_use": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "sensitivity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "role",
        "source_kind"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "monotonic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "status": {
          "enum": [
            "accepted",
            "conditional",
            "unresolved",
            "synthetic_design"
          ]
        },
        "allowed_values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evolving": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "conditional"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "conditions"
            ],
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "noun": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "primary": {
          "type": "boolean"
        },
        "cardinality_policy": {
          "const": "exact"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "status": {
          "enum": [
            "accepted",
            "conditional",
            "unresolved",
            "synthetic_design"
          ]
        }
      },
      "required": [
        "id",
        "fields"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "conditional"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "conditions"
            ],
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "cardinality_policy"
            ]
          },
          "then": {
            "required": [
              "count"
            ]
          }
        }
      ]
    },
    "relation": {
      "type": "object",
