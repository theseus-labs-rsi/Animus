            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    },
