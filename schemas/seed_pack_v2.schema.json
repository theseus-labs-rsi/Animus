          ]
        }
      },
      "required": [
        "id",
        "from_type",
        "to_type",
        "field",
        "temporal",
        "min_count"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "conditional"
