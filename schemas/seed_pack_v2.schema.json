          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "conditions": {
          "type": "array",
